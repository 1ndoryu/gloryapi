{
  "name": "gloryapi",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test -w server && npm run build:shared && npm run build -w client",
    "build": "npm run build:shared && npm run build -w server && npm run build -w client",
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build:shared && npm run build -w server",
    "quality:doctor": "node scripts/quality/quality-doctor.mjs",
    "quality:analyze": "node scripts/quality/sentinel-analyze.mjs",
    "quality:test": "npm test",
    "task:check": "node scripts/quality/task-check.mjs",
    "task:check:local": "node scripts/quality/task-check-local.mjs",
    "canary:codex": "node scripts/canary/run-codex-canary.cjs",
    "canary:codex:live": "node scripts/canary/run-live-provider-audit.cjs",
    "canary:codex:guard": "node scripts/canary/codex-version-guard.cjs",
    "bench:routing": "npm run build:server && node scripts/bench/routing-load.mjs",
    "recover:bundle": "npm run build:server && node server/dist/scripts/recover-bundle.js",
    "recover:profile": "npm run build:server && node server/dist/scripts/verify-recovery-profile.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
